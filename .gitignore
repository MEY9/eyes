# 本地环境与构建产物
.DS_Store
node_modules/
dist/
build/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# 教材、客户资料和未经确认的外部素材默认不进入远程仓库
materials/textbooks/**/*.pdf
materials/customer-data/
materials/private/
assets/unlicensed/

# 生成的临时媒体
products/**/generated/
output/paddleocr/
tmp/

# Codex / IDE 本地状态
.codex-local/
.idea/
.vscode/

# MCP 本地登录态与运行数据；仓库只提交 mcp/ 下的公开清单和说明
mcp/runtime/
mcp/local/
mcp/**/cookies.json
mcp/**/service.log
mcp/**/qrcode*.png

# PPT pipeline SQLite runtime state
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
